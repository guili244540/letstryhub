        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Repairable_di" bpmnElement="Gateway_Repairable" isMarkerVisible="true">
        <dc:Bounds x="810" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="858" y="208" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0cqsjrs_di" bpmnElement="Event_0cqsjrs">
        <dc:Bounds x="272" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="265" y="72" width="51" height="27" />
