<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:ehub="https://letstryhub.example/bpmn/ehub" id="Definitions_Fixtire" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_08az794">
    <bpmn:participant id="Participant_01tulrx" ehub:comment="BPMN Collaboration Pools (Participant Lanes)&#10;Driver Pool (Process_Fixcar): Represents the primary actor and internal workflow. Ranging from regular driving and self-diagnosis to carrying out minor repairs or requesting external help." name="Driver" processRef="Process_Fixcar" />
    <bpmn:participant id="Participant_0qex65i" ehub:comment="BPMN Collaboration Pools (Participant Lanes)&#10;Mobility Assistance Pool: Represents the external service provider&#39;s organization and operational workflow. It handles incoming assistance requests, dispatches on-site troubleshooting teams, provides response times, coordinates towing, and organizes replacement transport. Inter-pool communication is managed entirely via message flows." name="Mobility Assistance" processRef="Process_03yb2pl" />
    <bpmn:messageFlow id="Flow_1awdy3b" sourceRef="Event_0h3v8f6" targetRef="Event_1e4mj8z" />
    <bpmn:messageFlow id="Flow_0ouk452" sourceRef="Event_00kjgvw" targetRef="Event_0xcfh5l" />
    <bpmn:messageFlow id="Flow_TowRequest" targetRef="Event_ReceiveTowRequest" />
    <bpmn:messageFlow id="Flow_AssistanceDone" sourceRef="Event_AssistanceFinished" />
    <bpmn:messageFlow id="Flow_1jn3ng0" sourceRef="Event_1ioe1y6" targetRef="Event_AssistanceFinished" />
    <bpmn:messageFlow id="Flow_0tbd3bl" sourceRef="Event_0w9ny0f" targetRef="Event_09yrkva" />
    <bpmn:messageFlow id="Flow_0pw1yjg" sourceRef="Event_TuringPoint" targetRef="Event_ReceiveTowRequest" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Fixcar" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Driven" name="Car in motion">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_DetectProblem" name="Driving the car">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_0kyercl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InspectTire" name="Inspect the vehicle">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Repairable" ehub:comment="Exclusive (XOR) Gateway" name="Can we carry out the repairs ourselves?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0cqsjrs" name="Journey completed">
      <bpmn:incoming>Flow_0kyercl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_18rj6j4" ehub:url="https://guichet.public.lu/en/citoyens/transport/transports-individuels/vehicule-motorise/controle-technique-pneumatiques/controle-technique-obligatoire-vehicule.html" ehub:comment="Abstract Task (triggered by the non-interrupting &#34;Strange noise / behaviour&#34; boundary event)&#10;This task represents the driver&#39;s assessment phase when an anomaly (such as a noise, shock, or vibration) is detected while the car is in motion. The driver evaluates the severity of the issue to decide whether it is safe to continue driving or if an immediate stop is required" name="Evaluate">
      <bpmn:incoming>Flow_0erl78o</bpmn:incoming>
      <bpmn:outgoing>Flow_06e6nac</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_1gu9uf7" ehub:comment="Exclusive (XOR) Gateway&#10;This gateway evaluates the outcome of the driver&#39;s evaluation following an unusual noise, shock, or vibration.&#10;If &#34;Ok&#34;: The anomaly is deemed minor, allowing the driver to resume and complete the journey.&#10;If &#34;Not ok&#34;: The issue requires intervention, forcing the process to divert to the &#34;Stop and secure the vehicle&#34; task." name="How is it ?">
      <bpmn:incoming>Flow_06e6nac</bpmn:incoming>
      <bpmn:outgoing>Flow_1w48h6e</bpmn:outgoing>
      <bpmn:outgoing>Flow_1xzv3ug</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Driven" targetRef="Task_DetectProblem" />
    <bpmn:sequenceFlow id="Flow_0kyercl" sourceRef="Task_DetectProblem" targetRef="Event_0cqsjrs" />
    <bpmn:sequenceFlow id="Flow_2" name="pressure &#60; 1.5 bar" sourceRef="Event_1rew7ey" targetRef="Task_StopSecure" />
    <bpmn:sequenceFlow id="Flow_1xzv3ug" name="Not ok" sourceRef="Gateway_1gu9uf7" targetRef="Task_StopSecure" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_StopSecure" targetRef="Task_InspectTire" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_InspectTire" targetRef="Gateway_Repairable" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="Gateway_Repairable" targetRef="Task_RepairTire" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="Gateway_Repairable" targetRef="Task_ReplaceOrAssistance" />
    <bpmn:sequenceFlow id="Flow_0erl78o" name="noise, shock or vibration detected" sourceRef="Event_14w0ll0" targetRef="Activity_18rj6j4" />
    <bpmn:sequenceFlow id="Flow_06e6nac" sourceRef="Activity_18rj6j4" targetRef="Gateway_1gu9uf7" />
    <bpmn:sequenceFlow id="Flow_1w48h6e" name="Ok" sourceRef="Gateway_1gu9uf7" targetRef="EndEvent_JourneyResumed" />
    <bpmn:sequenceFlow id="Flow_1qij2u7" sourceRef="Task_ReplaceOrAssistance" targetRef="Activity_14loqq0" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_SafeToDrive" targetRef="EndEvent_JourneyResumed" />
    <bpmn:sequenceFlow id="Flow_07rn8bh" sourceRef="Event_0xcfh5l" targetRef="Activity_14loqq0" />
    <bpmn:sequenceFlow id="Flow_11d9xkg" sourceRef="Task_ReplaceOrAssistance" targetRef="Event_0h3v8f6" />
    <bpmn:task id="Task_ReplaceOrAssistance" ehub:url="https://www.acl.lu/en/assistance/mobility-assistance/" name="Call Mobility assistance">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_0to6oau</bpmn:incoming>
      <bpmn:outgoing>Flow_1qij2u7</bpmn:outgoing>
      <bpmn:outgoing>Flow_11d9xkg</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_14loqq0" name="Waiting for assistance to arrive and fix the issue">
      <bpmn:incoming>Flow_1qij2u7</bpmn:incoming>
      <bpmn:incoming>Flow_07rn8bh</bpmn:incoming>
      <bpmn:outgoing>Flow_1s09kp2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1s09kp2" sourceRef="Activity_14loqq0" targetRef="Activity_0ys0zml" />
    <bpmn:sequenceFlow id="Flow_ToDriverWait" sourceRef="Event_TuringPoint" targetRef="Activity_DriverWaitAssist" />
    <bpmn:sequenceFlow id="Flow_0wecllm" sourceRef="Task_RepairTire" targetRef="Gateway_0usqoy7" />
    <bpmn:sequenceFlow id="Flow_ToJourneyResumed" sourceRef="Activity_DriverWaitAssist" targetRef="EndEvent_JourneyResumed" />
    <bpmn:exclusiveGateway id="Gateway_SafeToDrive" ehub:comment="Exclusive (XOR) Gateway&#10;A decision point that aggregates the outcomes of either a self-performed or an external repair.&#10;If &#34;Yes&#34;: The driver proceeds directly to complete the journey.&#10;If &#34;No&#34;: The vehicle cannot be safely driven; the process redirects to the towing and transport request flow to arrange professional towing and a rental vehicle handover." name="Vehicle safe to drive?">
      <bpmn:incoming>Flow_1soj3qf</bpmn:incoming>
      <bpmn:incoming>Flow_0tb2ou1</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tb2mqa</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1tb2mqa" name="No" sourceRef="Gateway_SafeToDrive" targetRef="Event_TuringPoint" />
    <bpmn:sequenceFlow id="Flow_1soj3qf" sourceRef="Activity_0ys0zml" targetRef="Gateway_SafeToDrive" />
    <bpmn:sequenceFlow id="Flow_1pvedn7" sourceRef="Event_09yrkva" targetRef="Activity_0ys0zml" />
    <bpmn:task id="Activity_0ys0zml" name="Receives repair outcome">
      <bpmn:incoming>Flow_1s09kp2</bpmn:incoming>
      <bpmn:incoming>Flow_1pvedn7</bpmn:incoming>
      <bpmn:outgoing>Flow_1soj3qf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:adHocSubProcess id="Task_RepairTire" ehub:comment="Ad-Hoc Sub-process&#10;Representing the DIY fix, this container holds a set of independent tasks. Because it is an ad-hoc sub-process, these internal tasks do not enforce a strict sequential flow; they can be performed in any logical order, repeated, or skipped as required by the driver until the repair is complete." name="Repair">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_0wecllm</bpmn:outgoing>
      <bpmn:task id="Activity_03x6mpk" name="Inspect Damaged Component More Closely" />
      <bpmn:task id="Activity_0tfjmof" name="Retrieve Tools and Equipment" />
      <bpmn:task id="Activity_0l6huz6" name="Lift Vehicle" />
      <bpmn:task id="Activity_009xvnc" name="Apply Patch / Sealant or Change Wheel" />
      <bpmn:task id="Activity_1q5t6c6" name="Inflate / Adjust Tire Pressure" />
      <bpmn:task id="Activity_1exnhel" name="Secure Lug Nuts and Stow Equipment" />
    </bpmn:adHocSubProcess>
    <bpmn:intermediateThrowEvent id="Event_TuringPoint" name="Request towing &#38; transport">
      <bpmn:incoming>Flow_1tb2mqa</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDriverWait</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_TowingReq" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_0anxhtr" sourceRef="Event_AssistanceFinished" targetRef="Activity_DriverWaitAssist" />
    <bpmn:task id="Activity_DriverWaitAssist" name="Wait for towing &#38; rental handover">
      <bpmn:incoming>Flow_ToDriverWait</bpmn:incoming>
      <bpmn:incoming>Flow_0anxhtr</bpmn:incoming>
      <bpmn:outgoing>Flow_ToJourneyResumed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_JourneyResumed" name="Journey resumed">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_1w48h6e</bpmn:incoming>
      <bpmn:incoming>Flow_ToJourneyResumed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Event_0h3v8f6" ehub:comment="Intermediate Message Throw Event / Message Flow&#10;Triggered when the driver determines that roadside repairs cannot be performed independently and opts to call for professional help. This event transmits an explicit assistance request message across pools from the Driver process directly into the Mobility Assistance start event, initiating the external service provider&#39;s dispatch sequence." name="Assistance request">
      <bpmn:incoming>Flow_11d9xkg</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_11jv7cl" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_0xcfh5l">
      <bpmn:outgoing>Flow_07rn8bh</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0khwrcd" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_09yrkva">
      <bpmn:outgoing>Flow_1pvedn7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1w3wijp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_AssistanceFinished" name="Receive completion notice">
      <bpmn:outgoing>Flow_0anxhtr</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_AssistanceDone" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Task_StopSecure" ehub:comment="&#34;Stop and secure the vehicle&#34; collapsed Sub-Process (indicated by the plus sign or general container icon, representing a contained set of safety and immobilization steps)&#10;As a collapsed sub-process, it encapsulates the detailed sequence of pulling over safely, engaging parking brakes, activating hazard lights..." name="Stop and secure the vehicle">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_1xzv3ug</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:task id="Activity_0o7hzwn" name="Decelerate and pull over safely">
        <bpmn:incoming>Flow_07g9yqo</bpmn:incoming>
        <bpmn:outgoing>Flow_1pp9jit</bpmn:outgoing>
      </bpmn:task>
      <bpmn:startEvent id="Event_1qug0qh" name="Emergency Stop Required">
        <bpmn:outgoing>Flow_07g9yqo</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_07g9yqo" sourceRef="Event_1qug0qh" targetRef="Activity_0o7hzwn" />
      <bpmn:task id="Activity_1vxpss9" name="Engage hazard warning lights and parking brake">
        <bpmn:incoming>Flow_1pp9jit</bpmn:incoming>
        <bpmn:outgoing>Flow_0rpixcc</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_1pp9jit" sourceRef="Activity_0o7hzwn" targetRef="Activity_1vxpss9" />
      <bpmn:exclusiveGateway id="Gateway_17z0jpk" name="Is it dark or low visibility?">
        <bpmn:incoming>Flow_0rpixcc</bpmn:incoming>
        <bpmn:outgoing>Flow_10fsxjr</bpmn:outgoing>
        <bpmn:outgoing>Flow_18q0zhl</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0rpixcc" sourceRef="Activity_1vxpss9" targetRef="Gateway_17z0jpk" />
      <bpmn:task id="Activity_0my3547" name="Put on high-visibility safety vest and place warning triangle">
        <bpmn:incoming>Flow_10fsxjr</bpmn:incoming>
        <bpmn:outgoing>Flow_1ki1484</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_10fsxjr" sourceRef="Gateway_17z0jpk" targetRef="Activity_0my3547" />
      <bpmn:endEvent id="Event_108p76v">
        <bpmn:incoming>Flow_1ki1484</bpmn:incoming>
        <bpmn:incoming>Flow_18q0zhl</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1ki1484" sourceRef="Activity_0my3547" targetRef="Event_108p76v" />
      <bpmn:sequenceFlow id="Flow_18q0zhl" sourceRef="Gateway_17z0jpk" targetRef="Event_108p76v" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_0usqoy7" name="Repair completed ?">
      <bpmn:incoming>Flow_0wecllm</bpmn:incoming>
      <bpmn:outgoing>Flow_0tb2ou1</bpmn:outgoing>
      <bpmn:outgoing>Flow_0to6oau</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0tb2ou1" name="Yes" sourceRef="Gateway_0usqoy7" targetRef="Gateway_SafeToDrive" />
    <bpmn:sequenceFlow id="Flow_0to6oau" name="No" sourceRef="Gateway_0usqoy7" targetRef="Task_ReplaceOrAssistance" />
    <bpmn:boundaryEvent id="Event_14w0ll0" ehub:comment="Non-Interrupting Conditional Boundary Event (attached to &#34;Driving the car&#34;).&#10;This event monitors the vehicle for anomalies such as unusual sounds, physical shocks, or vibrations while the car is in motion. Because it is configured as non-interrupting (cancelActivity=&#34;false&#34;), it acts as an observer: it triggers an evaluation subprocess to assess the situation without forcing the driver to immediately pull over or stop the primary driving task." name="Strange noise / behaviour" cancelActivity="false" attachedToRef="Task_DetectProblem">
      <bpmn:outgoing>Flow_0erl78o</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscalationEventDefinition_13r2be0" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_1rew7ey" ehub:comment="Interrupting Conditional Boundary Event (attached to &#34;Driving the car&#34;)&#10;This event triggers when a critical threshold is breached (specifically, tire pressure dropping below 1.5 bar). Unlike the vibration event, this is an interrupting event: it forces an immediate break in the normal driving flow, directing the driver straight to the &#34;Stop and secure the vehicle&#34; task to handle a safety-critical flat tire." name="Dashboard tire alarm" attachedToRef="Task_DetectProblem">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0ggy67f" />
    </bpmn:boundaryEvent>
  </bpmn:process>
  <bpmn:process id="Process_03yb2pl" isExecutable="false">
    <bpmn:startEvent id="Event_1e4mj8z" name="Assistance request">
      <bpmn:outgoing>Flow_0o618i1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0l57ai7" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Event_00kjgvw" name="Provides the response time">
      <bpmn:incoming>Flow_1jsrccd</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_08md7mj" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_0w9ny0f" name="Repair status">
      <bpmn:incoming>Flow_084ya0j</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0pwwlas" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="Activity_0n494ab" name="On-site troubleshooting">
      <bpmn:incoming>Flow_08ofhaa</bpmn:incoming>
      <bpmn:outgoing>Flow_084ya0j</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ppjpke</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0qxqb9h" name="Dispatch operations">
      <bpmn:incoming>Flow_0o618i1</bpmn:incoming>
      <bpmn:outgoing>Flow_1jsrccd</bpmn:outgoing>
      <bpmn:outgoing>Flow_08ofhaa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TowVehicle" name="Vehicle is towed to a garage">
      <bpmn:incoming>Flow_Assist1</bpmn:incoming>
      <bpmn:outgoing>Flow_Assist2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TakePassengers" name="Passengers are taken to a car rental agency">
      <bpmn:incoming>Flow_Assist2</bpmn:incoming>
      <bpmn:outgoing>Flow_1815n75</bpmn:outgoing>
      <bpmn:outgoing>Flow_03ck5a4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Event_ReceiveTowRequest" name="Tow requested">
      <bpmn:outgoing>Flow_Assist1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RecvTow" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Event_1ioe1y6">
      <bpmn:incoming>Flow_1815n75</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1cees5d" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Event_1dta8dr">
      <bpmn:incoming>Flow_0ppjpke</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_1pouoa7">
      <bpmn:incoming>Flow_03ck5a4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0o618i1" sourceRef="Event_1e4mj8z" targetRef="Activity_0qxqb9h" />
    <bpmn:sequenceFlow id="Flow_1jsrccd" sourceRef="Activity_0qxqb9h" targetRef="Event_00kjgvw" />
    <bpmn:sequenceFlow id="Flow_084ya0j" sourceRef="Activity_0n494ab" targetRef="Event_0w9ny0f" />
    <bpmn:sequenceFlow id="Flow_08ofhaa" sourceRef="Activity_0qxqb9h" targetRef="Activity_0n494ab" />
    <bpmn:sequenceFlow id="Flow_0ppjpke" sourceRef="Activity_0n494ab" targetRef="Event_1dta8dr" />
    <bpmn:sequenceFlow id="Flow_Assist1" sourceRef="Event_ReceiveTowRequest" targetRef="Task_TowVehicle" />
    <bpmn:sequenceFlow id="Flow_Assist2" sourceRef="Task_TowVehicle" targetRef="Task_TakePassengers" />
    <bpmn:sequenceFlow id="Flow_1815n75" sourceRef="Task_TakePassengers" targetRef="Event_1ioe1y6" />
    <bpmn:sequenceFlow id="Flow_03ck5a4" sourceRef="Task_TakePassengers" targetRef="Event_1pouoa7" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Fixtire">
    <bpmndi:BPMNPlane id="BPMNPlane_Fixtire" bpmnElement="Collaboration_08az794">
      <bpmndi:BPMNShape id="Participant_01tulrx_di" bpmnElement="Participant_01tulrx" isHorizontal="true" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
